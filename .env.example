# Deploy/build identifier used by the installed PWA to detect a newer server build.
# Vercel automatically falls back to VERCEL_GIT_COMMIT_SHA, so this is optional there.
NEXT_PUBLIC_BUILD_ID=

# Public VAPID key for Web Push subscriptions.
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=

# Optional endpoint that accepts POST/DELETE JSON:
# { "subscription": PushSubscriptionJSON, "name": "<user agent>" }
# Leave blank if you only want browser-side subscription support for now.
NEXT_PUBLIC_PUSH_SUBSCRIPTION_ENDPOINT=
